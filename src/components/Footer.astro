---
import { getProfile } from "@/lib/content";

const profile = await getProfile();
const year = new Date().getFullYear();
---

<footer class="border-t border-rule">
    <div
        class="flex flex-col gap-2 px-6 py-8 mx-auto font-mono text-xs max-w-6xl text-faint sm:flex-row sm:justify-between md:px-12"
    >
        <span>deyleraf.dev</span>
        <span>© {year} {profile.name}</span>
    </div>
</footer>
