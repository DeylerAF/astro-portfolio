---
import { getProfile } from "@/lib/content";

const profile = await getProfile();

const META = [
    { label: "Experience", value: profile.yearsLabel },
    { label: "Based in", value: profile.location },
    { label: "Working", value: "Remote · Contract" },
];
---

<div class="flex flex-col gap-10 pt-20 pb-16 md:pt-28 md:pb-20">
    {
        profile.availability && (
            <div class="flex items-center gap-3 font-mono text-[0.6875rem] tracking-[0.1em] uppercase text-muted">
                <span class="inline-block rounded-full size-[7px] bg-accent" />
                <span>{profile.availability}</span>
            </div>
        )
    }

    <h1
        class="font-display font-semibold text-[2.5rem] leading-[1.02] tracking-[-0.03em] text-balance sm:text-6xl md:text-7xl lg:text-[5.5rem] lg:leading-[0.98]"
    >
        {profile.headline}
    </h1>

    <p class="max-w-xl text-lg leading-relaxed text-body md:text-xl">
        {profile.tagline}
    </p>
</div>

<div class="grid border-t border-b border-rule sm:grid-cols-2 lg:grid-cols-4">
    {
        META.map(({ label, value }) => (
            <div class="flex flex-col gap-1.5 px-0 py-5 border-b sm:px-6 sm:first:pl-0 border-rule sm:border-b-0 sm:border-r last:sm:border-r-0">
                <span class="eyebrow">{label}</span>
                <span class="text-[0.9375rem]">{value}</span>
            </div>
        ))
    }
    <div class="flex flex-col gap-1.5 py-5 sm:px-6">
        <span class="eyebrow">Elsewhere</span>
        <div class="flex gap-4 text-[0.9375rem]">
            <a
                href={profile.links.github}
                target="_blank"
                rel="noopener"
                class="transition-colors text-accent hover:text-ink">GitHub</a
            >
            <a
                href={profile.links.linkedin}
                target="_blank"
                rel="noopener"
                class="transition-colors text-accent hover:text-ink">LinkedIn</a
            >
        </div>
    </div>
</div>
