---
import { getProfile } from "@/lib/content";

const { about } = await getProfile();
---

<div class="grid gap-8 md:grid-cols-2 md:gap-12">
    {
        about.map((paragraph) => (
            <p class="text-[1.0625rem] leading-relaxed text-body">
                {paragraph}
            </p>
        ))
    }
</div>
