---
import { getProjects } from "@/lib/content";

const projects = await getProjects();
---

{
    projects.length === 0 ? (
        <p class="max-w-xl leading-relaxed text-muted">
            Most of my work runs inside companies and isn't mine to publish.
            I'm preparing a couple of pieces I can show — until then, the
            engagements above are the record.
        </p>
    ) : (
        <div class="flex flex-col">
            {projects.map((project) => (
                <article class="grid gap-6 py-8 border-t border-rule last:border-b lg:grid-cols-[1fr_18rem] lg:gap-10">
                    <div class="flex flex-col gap-3">
                        <h3 class="text-3xl font-semibold leading-tight font-display tracking-[-0.025em]">
                            {project.title}
                        </h3>
                        <p class="max-w-xl leading-relaxed text-muted">
                            {project.summary}
                        </p>
                        {project.description.map((paragraph) => (
                            <p class="max-w-xl leading-relaxed text-muted">
                                {paragraph}
                            </p>
                        ))}
                        <div class="flex gap-4 mt-1 font-mono text-sm">
                            {project.url && (
                                <a
                                    href={project.url}
                                    target="_blank"
                                    rel="noopener"
                                    class="transition-colors text-accent hover:text-ink"
                                >
                                    Visit ↗
                                </a>
                            )}
                            {project.repo && (
                                <a
                                    href={project.repo}
                                    target="_blank"
                                    rel="noopener"
                                    class="transition-colors text-accent hover:text-ink"
                                >
                                    Source ↗
                                </a>
                            )}
                        </div>
                    </div>

                    <div class="flex flex-wrap self-start gap-2">
                        {project.stack.map((item) => (
                            <span class="px-2.5 py-1 font-mono text-xs border text-body border-rule">
                                {item}
                            </span>
                        ))}
                    </div>
                </article>
            ))}
        </div>
    )
}
