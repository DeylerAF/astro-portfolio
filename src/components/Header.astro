---
import ThemeToggle from "./ThemeToggle.astro";
import { getProfile } from "@/lib/content";

const profile = await getProfile();

const NAV = [
    { href: "#services", label: "Services" },
    { href: "#work", label: "Work" },
    { href: "#about", label: "About" },
    { href: "#contact", label: "Contact" },
];
---

<header
    class="sticky top-0 z-20 border-b bg-paper/85 border-rule backdrop-blur-sm"
>
    <div
        class="flex items-center justify-between w-full gap-4 px-6 py-4 mx-auto max-w-6xl md:px-12"
    >
        <a
            href="#top"
            class="font-mono text-xs tracking-[0.06em] uppercase transition-opacity hover:opacity-60"
        >
            {profile.name}
        </a>

        <div class="flex items-center gap-6">
            <nav class="hidden gap-6 font-mono text-xs sm:flex">
                {
                    NAV.map(({ href, label }) => (
                        <a
                            href={href}
                            class="tracking-[0.04em] transition-colors text-muted hover:text-ink"
                        >
                            {label}
                        </a>
                    ))
                }
            </nav>
            <ThemeToggle />
        </div>
    </div>
</header>
