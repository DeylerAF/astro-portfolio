---
import { getProfile } from "@/lib/content";

const { services } = await getProfile();
---

{
    services.length > 0 && (
        <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
            {services.map((service, index) => (
                <div class="flex flex-col gap-3.5 pt-5 border-t-2 border-ink">
                    <span class="font-mono text-xs text-accent">
                        {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3 class="text-[1.375rem] font-display font-semibold leading-tight tracking-[-0.015em]">
                        {service.title}
                    </h3>
                    <p class="text-[0.9375rem] leading-relaxed text-muted">
                        {service.description}
                    </p>
                </div>
            ))}
        </div>
    )
}
